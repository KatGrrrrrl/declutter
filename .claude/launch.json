{
  "version": "0.0.1",
  "autoPort": true,
  "configurations": [
    {
      "name": "landing",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "landing/serve.mjs"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "web-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082
    },
    {
      "name": "web-alt2",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8083"
      ],
      "port": 8083
    }
  ]
}
